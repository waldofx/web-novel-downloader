{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nvd-app",
  "version": "0.1.0",
  "identifier": "dev.waldofx.web-novel-downloader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "nvd 遯ｶ繝ｻweb novel downloader",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
