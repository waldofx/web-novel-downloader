# Rust
/target/
**/*.rs.bk
*.pdb

# Generated by tauri-build on every build: the capability and ACL schema
# (300 KB of it), not source
**/gen/schemas/

# Generated exports (always regenerable from canonical chapter data)
exports/
raw/

# Local test fixtures (may contain personal reading lists / adult titles)
fixtures.local.json

# Secrets and sessions — never commit these
.env
.env.local
cookies.json
**/cookies/*.json

# Captured pages (personal, may contain adult content) — never commit
captures/
Thumbs.db

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
